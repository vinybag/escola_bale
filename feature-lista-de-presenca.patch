+    <form method="post" action="{% url 'admin_dashboard:presenca_marcar_manual' %}" class="pr-inline"
+          onsubmit="return confirm('Marcar presença de {{ r.aluna.nome|escapejs }} em {{ r.data|date:"d/m" }}?');">
+        {% csrf_token %}
+        <input type="hidden" name="next" value="{{ url_atual }}">
+        <input type="hidden" name="aluna" value="{{ r.aluna.pk }}">
+        <input type="hidden" name="turma" value="{{ r.turma.pk }}">
+        <input type="hidden" name="data" value="{{ r.data|date:'Y-m-d' }}">
