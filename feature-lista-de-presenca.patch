new file mode 100644
index 0000000..88ea37a
--- /dev/null
+++ b/presenca/templates/presenca/admin/ajustes.html
@@ -0,0 +1,98 @@
+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}QR Code e ajustes de presença{% endblock %}
+
+{% block content %}
+{% include 'presenca/admin/_estilo.html' %}
+
+<div class="pr-header">
+    <div>
+        <h2>QR Code e ajustes</h2>
+        <p>O QR Code da escola, o horário em que o registro abre e o início do controle.</p>
+    </div>
+</div>
+
+{% include 'presenca/admin/_abas.html' with aba='ajustes' %}
+
+{% if turmas_pendentes %}
+<div class="pr-aviso atencao">
+    <strong>Turmas sem horário cadastrado:</strong>
+    {% for t in turmas_pendentes %}<a href="{% url 'admin_dashboard:turma_editar' t.pk %}">{{ t.nome }}</a>{% if not forloop.last %}, {% endif %}{% endfor %}.
+    Cadastre o dia e a hora de início/fim na edição da turma.
+</div>
+{% endif %}
+
+{% if horarios_automaticos %}
+<div class="pr-aviso info">
+    {{ horarios_automaticos }} horário{{ horarios_automaticos|pluralize }} de turma
+    {{ horarios_automaticos|pluralize:"foi,foram" }} preenchido{{ horarios_automaticos|pluralize }} automaticamente a partir do texto antigo.
+    Confira em <a href="{% url 'admin_dashboard:turmas_list' %}">Turmas</a> (editar) e depois confirme aqui:
+    <form method="post" class="pr-inline" style="margin-left: 0.5rem;">
+        {% csrf_token %}
+        <input type="hidden" name="acao" value="confirmar_horarios">
+        <button type="submit" class="pr-btn ok">Está tudo certo, confirmar</button>
+    </form>
+</div>
+{% endif %}
+
+<div class="pr-card">
+    <h3>QR Code da escola</h3>
+    <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;">
+        <img src="{% url 'admin_dashboard:presenca_qr_png' %}?v={{ config.qr_gerado_em|date:'U' }}" alt="QR Code de presença"
+             style="width: 220px; height: 220px; border: 1px solid #ebe3f1; border-radius: 12px; padding: 8px; background: #fff;">
+        <div style="flex: 1 1 280px; min-width: 0;">
+            <p style="margin-top: 0; color: #444; line-height: 1.55;">
+                Imprima e cole na entrada da escola. Quem escaneia cai direto na página de presença
+                (e, se não estiver logada, entra com a conta e a presença é registrada em seguida).
+            </p>
+            <p style="color: #8a8490; font-size: 0.82rem; word-break: break-all; margin: 0.5rem 0;">{{ url_qr }}</p>
+            <p style="color: #8a8490; font-size: 0.82rem; margin: 0 0 1rem 0;">
+                Gerado em {{ config.qr_gerado_em|date:"d/m/Y H:i" }}.
+            </p>
+            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
+                <a href="{% url 'admin_dashboard:presenca_qr_imprimir' %}" target="_blank" class="pr-btn principal">Abrir página para imprimir</a>
+                <a href="{% url 'admin_dashboard:presenca_qr_png' %}?baixar=1" class="pr-btn">Baixar imagem (PNG)</a>
+            </div>
+        </div>
+    </div>
+
+    <div class="pr-aviso atencao" style="margin: 1.25rem 0 0 0;">
+        <strong>Importante:</strong> como o QR Code é fixo, alguém pode fotografá-lo e usar de casa.
+        O registro só funciona de {{ config.minutos_antes }} min antes do início até o fim de cada aula,
+        e você pode <em>desmarcar</em> qualquer presença na aba "Aulas e presenças". Se o código vazar,
+        gere um novo abaixo e troque o impresso.
+        <form method="post" class="pr-inline" style="display: block; margin-top: 0.6rem;"
+              onsubmit="return confirm('Gerar um QR Code novo? O QR Code impresso atual deixará de funcionar até você trocá-lo.');">
+            {% csrf_token %}
+            <input type="hidden" name="acao" value="novo_qr">
+            <button type="submit" class="pr-btn perigo">Gerar QR Code novo</button>
+        </form>
+    </div>
+</div>
+
+<div class="pr-card">
+    <h3>Ajustes</h3>
+    <form method="post" class="pr-form">
+        {% csrf_token %}
+        <input type="hidden" name="acao" value="salvar">
+        <div>
+            <label for="a-antes">Registro abre (minutos antes da aula)</label>
+            <input type="number" id="a-antes" name="minutos_antes" min="0" max="240" value="{{ config.minutos_antes }}">
+        </div>
+        <div>
+            <label for="a-depois">Registro ainda vale (minutos depois do fim)</label>
+            <input type="number" id="a-depois" name="minutos_depois" min="0" max="240" value="{{ config.minutos_depois }}">
+        </div>
+        <div>
+            <label for="a-inicio">Início do controle de presença</label>
+            <input type="date" id="a-inicio" name="data_inicio_controle" value="{{ config.data_inicio_controle|date:'Y-m-d' }}">
+        </div>
+        <p class="ajuda">
+            Aulas anteriores ao "início do controle" nunca contam como falta. Por padrão é o dia em que o sistema
+            foi instalado, para as alunas atuais não receberem faltas antigas.
+            O horário de início/fim de cada turma é cadastrado na edição da turma.
+        </p>
+        <div><button type="submit" class="pr-btn principal" style="padding: 0.75rem 1.2rem;">Salvar ajustes</button></div>
+    </form>
+</div>
+{% endblock %}
diff --git a/presenca/templates/presenca/admin/aluna.html b/presenca/templates/presenca/admin/aluna.html
new file mode 100644
index 0000000..0b78751
--- /dev/null
+++ b/presenca/templates/presenca/admin/aluna.html
@@ -0,0 +1,91 @@
+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}Presença - {{ aluna.nome }}{% endblock %}
+
+{% block content %}
+{% include 'presenca/admin/_estilo.html' %}
+
+<div class="pr-header">
+    <div>
+        <h2>{{ aluna.nome }}</h2>
+        <p>Histórico de presença{% if not aluna.ativa %} · <strong>aluna inativa</strong>{% endif %}</p>
+    </div>
+    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
+        <a href="{% url 'admin_dashboard:aluna_detalhes' aluna.pk %}" class="pr-btn">Ver cadastro</a>
+        <a href="{% url 'admin_dashboard:presenca_resumo' %}" class="pr-btn">‹ Resumo por aluna</a>
+    </div>
+</div>
+
+{% include 'presenca/admin/_abas.html' with aba='resumo' %}
+
+<div class="pr-card">
+    <h3>Turmas e horários</h3>
+    <div class="pr-turmas-tags">
+        {% for t in turmas %}
+            <span class="pr-tag">
+                {{ t.nome }}{% for h in t.horarios_aula.all %} · {{ h.dia_curto }} {{ h.intervalo_texto }}{% endfor %}
+            </span>
+        {% empty %}
+            <span style="color: #8a8490;">Nenhuma turma com horário cadastrado.</span>
+        {% endfor %}
+    </div>
+    <p style="margin: 0.8rem 0 0 0; color: #8a8490; font-size: 0.82rem;">
+        Controle contado desde {{ inicio_controle|date:"d/m/Y" }}.
+    </p>
+</div>
+
+<div class="pr-kpis">
+    <div class="pr-kpi rosa"><small>Faltas em {{ mes_rotulo }}</small><strong>{{ mes_dados.falta }}</strong></div>
+    <div class="pr-kpi verde"><small>Presenças em {{ mes_rotulo }}</small><strong>{{ mes_dados.presente }}</strong></div>
+    <div class="pr-kpi rosa"><small>Faltas no total</small><strong>{{ geral.falta }}</strong></div>
+    <div class="pr-kpi"><small>Frequência geral</small><strong>{% if geral.frequencia is not None %}{{ geral.frequencia }}%{% else %}—{% endif %}</strong></div>
+    <div class="pr-kpi"><small>Faltas seguidas (agora)</small><strong>{{ sequencia_atual }}</strong></div>
+    <div class="pr-kpi"><small>Maior sequência</small><strong>{{ maior_sequencia }}</strong></div>
+</div>
+
+<div class="pr-card">
+    <h3>Mês a mês</h3>
+    {% if historico %}
+    <div class="pr-tabela-wrap">
+        <table class="pr-tabela">
+            <thead>
+                <tr><th>Mês</th><th class="num">Aulas</th><th class="num">Presenças</th><th class="num">Faltas</th><th></th><th class="num">Frequência</th></tr>
+            </thead>
+            <tbody>
+            {% for h in historico %}
+                <tr {% if h.ativo %}style="background: #faf7fc;"{% endif %}>
+                    <td style="text-transform: capitalize;"><a href="?mes={{ h.chave }}">{{ h.rotulo }}</a></td>
+                    <td class="num">{{ h.dados.aulas }}</td>
+                    <td class="num">{{ h.dados.presente }}</td>
+                    <td class="num"><span class="pr-faltas-num {% if h.dados.falta %}tem{% endif %}">{{ h.dados.falta }}</span></td>
+                    <td style="width: 28%;"><div class="pr-barra"><span style="width: {{ h.largura }}%;"></span></div></td>
+                    <td class="num">{% if h.dados.frequencia is not None %}{{ h.dados.frequencia }}%{% else %}—{% endif %}</td>
+                </tr>
+            {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
+        <p style="color: #8a8490; margin: 0;">Ainda não há aulas registradas no controle.</p>
+    {% endif %}
+</div>
+
+<h3 class="pr-dia">Aulas de {{ mes_rotulo }}</h3>
+{% if registros %}
+<section class="pr-aula">
+    {% for r in registros %}
+    <div class="pr-linha">
+        <div class="quem">
+            <strong style="color: #35203f;">{{ r.data|date:"D, d/m" }}</strong> · {{ r.turma.nome }}
+            <span style="color: #6b2d8f; font-weight: 700;">{{ r.inicio|time:"H:i" }}–{{ r.fim|time:"H:i" }}</span>
+            <small>{% include 'presenca/admin/_info.html' %}</small>
+        </div>
+        <div>{% include 'presenca/admin/_status.html' %}</div>
+        <div class="acoes">{% include 'presenca/admin/_acoes.html' %}</div>
+    </div>
+    {% endfor %}
+</section>
+{% else %}
+    <div class="pr-vazio">Nenhuma aula neste mês.</div>
+{% endif %}
+{% endblock %}
diff --git a/presenca/templates/presenca/admin/dias_sem_aula.html b/presenca/templates/presenca/admin/dias_sem_aula.html
new file mode 100644
index 0000000..135f1e9
--- /dev/null
+++ b/presenca/templates/presenca/admin/dias_sem_aula.html
@@ -0,0 +1,68 @@
+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}Dias sem aula{% endblock %}
+
+{% block content %}
+{% include 'presenca/admin/_estilo.html' %}
+
+<div class="pr-header">
+    <div>
+        <h2>Dias sem aula</h2>
+        <p>Feriados e recessos. Nesses dias ninguém recebe falta e o QR Code não registra presença.</p>
+    </div>
+</div>
+
+{% include 'presenca/admin/_abas.html' with aba='folgas' %}
+
+<div class="pr-card">
+    <h3>Adicionar dia sem aula</h3>
+    <form method="post" class="pr-form">
+        {% csrf_token %}
+        <div>
+            <label for="d-data">Data</label>
+            <input type="date" id="d-data" name="data" required>
+        </div>
+        <div>
+            <label for="d-turma">Vale para</label>
+            <select id="d-turma" name="turma">
+                <option value="">Todas as turmas</option>
+                {% for t in turmas %}<option value="{{ t.pk }}">{{ t.nome }}</option>{% endfor %}
+            </select>
+        </div>
+        <div>
+            <label for="d-motivo">Motivo (opcional)</label>
+            <input type="text" id="d-motivo" name="motivo" maxlength="120" placeholder="Ex.: Feriado, recesso de julho">
+        </div>
+        <div><button type="submit" class="pr-btn principal" style="padding: 0.75rem 1.2rem;">Adicionar</button></div>
+    </form>
+</div>
+
+<div class="pr-card">
+    <h3>Cadastrados</h3>
+    {% if folgas %}
+    <div class="pr-tabela-wrap">
+        <table class="pr-tabela">
+            <thead><tr><th>Data</th><th>Vale para</th><th>Motivo</th><th></th></tr></thead>
+            <tbody>
+            {% for f in folgas %}
+                <tr>
+                    <td><strong>{{ f.data|date:"D, d/m/Y" }}</strong></td>
+                    <td>{% if f.turma %}{{ f.turma.nome }}{% else %}Todas as turmas{% endif %}</td>
+                    <td>{{ f.motivo|default:"—" }}</td>
+                    <td style="text-align: right;">
+                        <form method="post" action="{% url 'admin_dashboard:presenca_dia_sem_aula_excluir' f.pk %}" class="pr-inline"
+                              onsubmit="return confirm('Remover este dia sem aula? As faltas desse dia voltam a valer.');">
+                            {% csrf_token %}
+                            <button type="submit" class="pr-btn perigo">Remover</button>
+                        </form>
+                    </td>
+                </tr>
+            {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
+        <p style="color: #8a8490; margin: 0;">Nenhum dia sem aula cadastrado.</p>
+    {% endif %}
+</div>
+{% endblock %}
diff --git a/presenca/templates/presenca/admin/lista.html b/presenca/templates/presenca/admin/lista.html
new file mode 100644
index 0000000..d1a3087
--- /dev/null
+++ b/presenca/templates/presenca/admin/lista.html
@@ -0,0 +1,131 @@
+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}Lista de presença{% endblock %}
+
+{% block content %}
+{% include 'presenca/admin/_estilo.html' %}
+
+<div class="pr-header">
+    <div>
+        <h2>Lista de presença</h2>
+        <p>Aulas do dia, separadas por turma. Desmarque quem registrou mas não foi à aula.</p>
+    </div>
+</div>
+
+{% include 'presenca/admin/_abas.html' with aba='lista' %}
+
+{% if turmas_pendentes %}
+<div class="pr-aviso atencao">
+    <strong>Turmas sem horário cadastrado:</strong>
+    {% for t in turmas_pendentes %}<a href="{% url 'admin_dashboard:turma_editar' t.pk %}">{{ t.nome }}</a>{% if not forloop.last %}, {% endif %}{% endfor %}.
+    Enquanto não tiverem horário (dia + hora de início e fim), essas turmas não aparecem aqui, não aceitam presença pelo QR Code e não geram falta.
+</div>
+{% endif %}
+
+{% if horarios_automaticos %}
+<div class="pr-aviso info">
+    {{ horarios_automaticos }} horário{{ horarios_automaticos|pluralize:" foi,s foram" }} preenchido{{ horarios_automaticos|pluralize }}
+    automaticamente a partir do texto antigo das turmas. Confira em
+    <a href="{% url 'admin_dashboard:turmas_list' %}">Turmas</a> e depois confirme em
+    <a href="{% url 'admin_dashboard:presenca_ajustes' %}">QR Code e ajustes</a>.
+</div>
+{% endif %}
+
+{% if folgas_periodo %}
+<div class="pr-aviso info">
+    <strong>Dia sem aula:</strong>
+    {% for d, textos in folgas_periodo %}{{ d|date:"d/m" }} — {{ textos|join:"; " }}{% if not forloop.last %} · {% endif %}{% endfor %}
+</div>
+{% endif %}
+
+<div class="pr-navperiodo">
+    <div class="pr-segmentado">
+        <a href="{{ url_dia }}" class="{% if periodo == 'dia' %}ativa{% endif %}">Dia</a>
+        <a href="{{ url_semana }}" class="{% if periodo == 'semana' %}ativa{% endif %}">Semana</a>
+        <a href="{{ url_mes }}" class="{% if periodo == 'mes' %}ativa{% endif %}">Mês</a>
+    </div>
+    <div class="pr-rotulo">
+        <a href="{{ url_anterior }}" class="pr-btn">‹ Anterior</a>
+        <strong>{% if periodo == 'dia' %}{{ referencia|date:"l, d/m/Y" }}{% else %}{{ rotulo_periodo }}{% endif %}</strong>
+        <a href="{{ url_proximo }}" class="pr-btn">Próximo ›</a>
+        <a href="{{ url_hoje }}" class="pr-btn principal">Hoje</a>
+    </div>
+</div>
+
+<div class="pr-card">
+    <form method="get" class="pr-filtros">
+        <input type="hidden" name="periodo" value="{{ periodo }}">
+        <div>
+            <label for="f-data">Data de referência</label>
+            <input type="date" id="f-data" name="data" value="{{ referencia|date:'Y-m-d' }}">
+        </div>
+        <div>
+            <label for="f-turma">Turma</label>
+            <select id="f-turma" name="turma">
+                <option value="">Todas</option>
+                {% for t in turmas %}<option value="{{ t.pk }}" {% if t.pk == turma_id %}selected{% endif %}>{{ t.nome }}</option>{% endfor %}
+            </select>
+        </div>
+        <div>
+            <label for="f-aluna">Aluna</label>
+            <select id="f-aluna" name="aluna">
+                <option value="">Todas</option>
+                {% for a in alunas %}<option value="{{ a.pk }}" {% if a.pk == aluna_id %}selected{% endif %}>{{ a.nome }}</option>{% endfor %}
+            </select>
+        </div>
+        <div>
+            <label for="f-status">Situação</label>
+            <select id="f-status" name="status">
+                <option value="">Todas</option>
+                <option value="presente" {% if status == 'presente' %}selected{% endif %}>Presentes</option>
+                <option value="falta" {% if status == 'falta' %}selected{% endif %}>Faltas</option>
+                <option value="aguardando" {% if status == 'aguardando' %}selected{% endif %}>Aguardando</option>
+            </select>
+        </div>
+        <div style="display: flex; gap: 0.5rem;">
+            <button type="submit" class="pr-btn principal" style="padding: 0.75rem 1.1rem;">Filtrar</button>
+            <a href="{% url 'admin_dashboard:presenca_lista' %}" class="pr-btn" style="padding: 0.75rem 1.1rem;">Limpar</a>
+        </div>
+    </form>
+</div>
+
+<div class="pr-kpis">
+    <div class="pr-kpi verde"><small>Presenças</small><strong>{{ resumo.presente }}</strong></div>
+    <div class="pr-kpi rosa"><small>Faltas</small><strong>{{ resumo.falta }}</strong></div>
+    <div class="pr-kpi"><small>Aguardando</small><strong>{{ resumo.aguardando }}</strong></div>
+    <div class="pr-kpi"><small>Frequência</small><strong>{% if resumo.frequencia is not None %}{{ resumo.frequencia }}%{% else %}—{% endif %}</strong></div>
+</div>
+
+{% for dia in dias %}
+    <h3 class="pr-dia">{{ dia.data|date:"l, d/m/Y" }}</h3>
+
+    {% for bloco in dia.blocos %}
+    <section class="pr-aula">
+        <div class="pr-aula-topo">
+            <div>
+                <strong>{{ bloco.turma.nome }}</strong>
+                <span class="horario">{{ bloco.inicio|time:"H:i" }}–{{ bloco.fim|time:"H:i" }}</span>
+            </div>
+            <div class="pr-contagem">
+                <span>✅ {{ bloco.presentes }} presente{{ bloco.presentes|pluralize }}</span>
+                <span>❌ {{ bloco.faltas }} falta{{ bloco.faltas|pluralize }}</span>
+                {% if bloco.aguardando %}<span>⏳ {{ bloco.aguardando }} aguardando</span>{% endif %}
+            </div>
+        </div>
+
+        {% for r in bloco.linhas %}
+        <div class="pr-linha">
+            <div class="quem">
+                <a href="{% url 'admin_dashboard:presenca_aluna' r.aluna.pk %}">{{ r.aluna.nome }}</a>
+                <small>{% include 'presenca/admin/_info.html' %}</small>
+            </div>
+            <div>{% include 'presenca/admin/_status.html' %}</div>
+            <div class="acoes">{% include 'presenca/admin/_acoes.html' %}</div>
+        </div>
+        {% endfor %}
+    </section>
+    {% endfor %}
+{% empty %}
+    <div class="pr-vazio">{{ vazio }}</div>
+{% endfor %}
+{% endblock %}
diff --git a/presenca/templates/presenca/admin/qr_imprimir.html b/presenca/templates/presenca/admin/qr_imprimir.html
new file mode 100644
index 0000000..405c0fd
--- /dev/null
+++ b/presenca/templates/presenca/admin/qr_imprimir.html
@@ -0,0 +1,36 @@
+<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>QR Code de presença</title>
+    <style>
+        * { box-sizing: border-box; }
+        body { margin: 0; font-family: Arial, Helvetica, sans-serif; color: #35203f; background: #fff; }
+        .folha { max-width: 620px; margin: 0 auto; padding: 2.5rem 1.5rem; text-align: center; }
+        .escola { font-size: 1.1rem; letter-spacing: 0.08em; text-transform: uppercase; color: #6b2d8f; font-weight: 700; }
+        h1 { font-size: 2.2rem; margin: 0.6rem 0 0.4rem 0; color: #4a235f; }
+        p { font-size: 1.15rem; line-height: 1.5; margin: 0.4rem 0; }
+        img { width: 100%; max-width: 420px; height: auto; margin: 1.5rem auto; display: block; border: 3px solid #6b2d8f; border-radius: 18px; padding: 14px; }
+        .passos { text-align: left; display: inline-block; margin-top: 0.5rem; font-size: 1.05rem; line-height: 1.7; }
+        .acoes { margin-top: 2rem; }
+        button { background: #6b2d8f; color: #fff; border: none; border-radius: 10px; padding: 0.8rem 1.6rem; font-size: 1rem; font-weight: 700; cursor: pointer; }
+        @media print { .acoes { display: none; } }
+    </style>
+</head>
+<body>
+    <div class="folha">
+        <div class="escola">{{ SITE_NAME }}</div>
+        <h1>Presença na aula 🩰</h1>
+        <p>Escaneie com a câmera do celular ao chegar.</p>
+        <img src="{% url 'admin_dashboard:presenca_qr_png' %}" alt="QR Code de presença">
+        <div class="passos">
+            1. Abra a câmera do celular e aponte para o código.<br>
+            2. Entre na sua conta, se for pedido.<br>
+            3. Pronto! A presença é registrada.
+        </div>
+        <p style="font-size: 0.9rem; color: #7b7580; margin-top: 1.5rem;">O registro abre {{ minutos_antes }} minutos antes da aula.</p>
+        <div class="acoes"><button type="button" onclick="window.print()">Imprimir</button></div>
+    </div>
+</body>
+</html>
diff --git a/presenca/templates/presenca/admin/resumo.html b/presenca/templates/presenca/admin/resumo.html
new file mode 100644
index 0000000..c9a7ad7
--- /dev/null
+++ b/presenca/templates/presenca/admin/resumo.html
@@ -0,0 +1,105 @@
+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}Resumo de presença{% endblock %}
+
+{% block content %}
+{% include 'presenca/admin/_estilo.html' %}
+
+<div class="pr-header">
+    <div>
+        <h2>Resumo por aluna</h2>
+        <p>Quanto cada aluna falta. Clique no nome para ver o detalhe mês a mês.</p>
+    </div>
+</div>
+
+{% include 'presenca/admin/_abas.html' with aba='resumo' %}
+
+<div class="pr-navperiodo">
+    <div class="pr-segmentado">
+        <a href="{{ url_semana }}" class="{% if periodo == 'semana' %}ativa{% endif %}">Semana</a>
+        <a href="{{ url_mes }}" class="{% if periodo == 'mes' %}ativa{% endif %}">Mês</a>
+        <a href="{{ url_tudo }}" class="{% if periodo == 'tudo' %}ativa{% endif %}">Desde o início</a>
+    </div>
+    <div class="pr-rotulo">
+        {% if url_anterior %}<a href="{{ url_anterior }}" class="pr-btn">‹ Anterior</a>{% endif %}
+        <strong>{{ rotulo }}</strong>
+        {% if url_proximo %}<a href="{{ url_proximo }}" class="pr-btn">Próximo ›</a>{% endif %}
+    </div>
+</div>
+
+<div class="pr-card">
+    <form method="get" class="pr-filtros" style="grid-template-columns: 1.6fr 1.2fr 1fr auto;">
+        <input type="hidden" name="periodo" value="{{ periodo }}">
+        <input type="hidden" name="data" value="{{ referencia|date:'Y-m-d' }}">
+        <div>
+            <label for="r-busca">Buscar aluna</label>
+            <input type="text" id="r-busca" name="busca" value="{{ busca }}" placeholder="Nome da aluna...">
+        </div>
+        <div>
+            <label for="r-turma">Turma</label>
+            <select id="r-turma" name="turma">
+                <option value="">Todas</option>
+                {% for t in turmas %}<option value="{{ t.pk }}" {% if t.pk == turma_id %}selected{% endif %}>{{ t.nome }}</option>{% endfor %}
+            </select>
+        </div>
+        <div>
+            <label for="r-ordem">Ordenar por</label>
+            <select id="r-ordem" name="ordem">
+                <option value="faltas" {% if ordem == 'faltas' %}selected{% endif %}>Mais faltas</option>
+                <option value="frequencia" {% if ordem == 'frequencia' %}selected{% endif %}>Menor frequência</option>
+                <option value="nome" {% if ordem == 'nome' %}selected{% endif %}>Nome</option>
+            </select>
+        </div>
+        <div style="display: flex; gap: 0.5rem;">
+            <button type="submit" class="pr-btn principal" style="padding: 0.75rem 1.1rem;">Filtrar</button>
+            <a href="{% url 'admin_dashboard:presenca_resumo' %}" class="pr-btn" style="padding: 0.75rem 1.1rem;">Limpar</a>
+        </div>
+    </form>
+</div>
+
+<div class="pr-kpis">
+    <div class="pr-kpi verde"><small>Presenças</small><strong>{{ geral.presente }}</strong></div>
+    <div class="pr-kpi rosa"><small>Faltas</small><strong>{{ geral.falta }}</strong></div>
+    <div class="pr-kpi"><small>Alunas com falta</small><strong>{{ alunas_com_falta }}</strong></div>
+    <div class="pr-kpi"><small>Frequência geral</small><strong>{% if geral.frequencia is not None %}{{ geral.frequencia }}%{% else %}—{% endif %}</strong></div>
+</div>
+
+<div class="pr-card">
+    <div class="pr-tabela-wrap">
+        <table class="pr-tabela">
+            <thead>
+                <tr>
+                    <th>Aluna</th>
+                    <th class="num">Aulas</th>
+                    <th class="num">Presenças</th>
+                    <th class="num">Faltas</th>
+                    <th class="num">Frequência</th>
+                </tr>
+            </thead>
+            <tbody>
+            {% for l in linhas %}
+                <tr>
+                    <td>
+                        <a href="{% url 'admin_dashboard:presenca_aluna' l.aluna.pk %}">{{ l.aluna.nome }}</a>
+                        <small>{% for t in l.aluna.turmas.all %}{{ t.nome }}{% if not forloop.last %}, {% endif %}{% empty %}Sem turma{% endfor %}</small>
+                    </td>
+                    <td class="num">{{ l.dados.aulas }}</td>
+                    <td class="num">{{ l.dados.presente }}</td>
+                    <td class="num"><span class="pr-faltas-num {% if l.dados.falta %}tem{% endif %}">{{ l.dados.falta }}</span></td>
+                    <td class="num">
+                        {% if l.dados.frequencia is not None %}
+                            <span class="pr-badge {% if l.dados.frequencia >= 75 %}presente{% else %}falta{% endif %}">{{ l.dados.frequencia }}%</span>
+                        {% else %}—{% endif %}
+                    </td>
+                </tr>
+            {% empty %}
+                <tr><td colspan="5" style="text-align: center; color: #8a8490; padding: 2rem;">Nenhuma aluna encontrada.</td></tr>
+            {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    <p style="margin: 0.9rem 0 0 0; color: #8a8490; font-size: 0.82rem;">
+        "Aulas" conta só aulas que já terminaram. Frequência abaixo de 75% aparece em vermelho.
+    </p>
+</div>
+{% endblock %}
