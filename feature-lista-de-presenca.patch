+{% if r.status == 'presente' %}
+    <form method="post" action="{% url 'admin_dashboard:presenca_desmarcar' r.presenca.pk %}" class="pr-inline"
+          data-nome="{{ r.aluna.nome }}" onsubmit="return prDesmarcar(this);">
+        {% csrf_token %}
+        <input type="hidden" name="next" value="{{ url_atual }}">
+        <input type="hidden" name="motivo" value="">
+        <button type="submit" class="pr-btn perigo">Desmarcar</button>
+    </form>
+{% elif r.desmarcada %}
+    <form method="post" action="{% url 'admin_dashboard:presenca_restaurar' r.presenca.pk %}" class="pr-inline">
+        {% csrf_token %}
+        <input type="hidden" name="next" value="{{ url_atual }}">
+        <button type="submit" class="pr-btn ok">Restaurar presença</button>
+    </form>
