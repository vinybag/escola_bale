@@ -1450,6 +1450,22 @@ def meus_ingressos(request):
     return render(request, 'espetaculo/meus_ingressos.html', context)
 
 
+def _nome_download_png(prefixo, ingresso):
+    """
+    Nome do arquivo que a pessoa recebe ao baixar o ingresso/QR code,
+    sempre terminando em ".png" (ex.: "ingresso-12C51109C50C.png").
+
+    Não depende do nome guardado no storage: o Cloudinary guarda esse
+    nome sem extensão, e foi isso que fazia o arquivo ser baixado como
+    ".bin".
+    """
+    from django.utils.text import get_valid_filename
+
+    codigo = get_valid_filename(str(ingresso.codigo_unico or ingresso.pk))
+
+    return f"{prefixo}-{codigo}.png"
+
+
 def ver_imagem_ingresso(request, ingresso_id):
     ingresso = get_object_or_404(IngressoEvento, id=ingresso_id)
 
@@ -1493,10 +1509,16 @@ def baixar_ingresso(request, ingresso_id):
     if not nome or not storage.exists(nome):
         raise Http404("Arquivo do ingresso não existe no disco.")
 
+    # CORREÇÃO: o nome guardado no Cloudinary (public_id) vem SEM
+    # extensão, então antes o download saía sem tipo definido e sem
+    # ".png" no nome — e o celular salvava como ".bin". Agora o tipo
+    # (PNG, que é o formato em que o ingresso é gerado) e o nome do
+    # arquivo são definidos explicitamente.
     return FileResponse(
         storage.open(nome, "rb"),
         as_attachment=True,
-        filename=os.path.basename(nome),
+        filename=_nome_download_png("ingresso", ingresso),
+        content_type="image/png",
     )
 
 
