+
+    def test_cortesia_e_gratuito_nao_entram(self):
+        self._pedido(status='pago', valor_total=Decimal('0.00'))
+        self._pedido(
+            whatsapp='(21) 98888-7777',
+            status='pago',
+            external_reference='ingresso_gratuito_aluna:1',
