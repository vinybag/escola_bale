+                     minutos_atras=3)
+
+        self.assertEqual(
+            self._status(),
+            {'5511912345678': NAO_FINALIZOU, '5521988887777': EM_ANDAMENTO},
+        )
+
+    def test_sem_pix_nao_entra(self):
+        self._pedido(status='expirado', pix=False)
