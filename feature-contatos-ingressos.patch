+{% extends 'admin_dashboard/base.html' %}
+
+{% block title %}
+    Contatos de ingressos - {{ espetaculo.titulo }}
+{% endblock %}
+
+{% block content %}
+<style>
+    .ct-header {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 1rem;
+        flex-wrap: wrap;
+        margin-bottom: 1.5rem;
+    }
+
+    .ct-shell {
+        width: 100%;
+        max-width: 1100px;
+        min-width: 0;
+    }
+
+    .ct-summary {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
+        gap: 0.8rem;
+        margin-bottom: 1.25rem;
+    }
+
+    .ct-summary-card {
+        display: block;
+        padding: 0.9rem 1rem;
+        border: 2px solid transparent;
+        border-radius: 14px;
+        background: #fff;
+        box-shadow: 0 4px 14px rgba(74, 35, 95, 0.07);
+        text-decoration: none;
+        color: inherit;
+    }
+
+    .ct-summary-card.ativo {
+        border-color: #6b2d8f;
+    }
+
+    .ct-summary-label {
+        color: #7a7280;
+        font-size: 0.8rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.03em;
+    }
+
+    .ct-summary-value {
+        color: #4a235f;
+        font-size: 1.6rem;
+        font-weight: 800;
+    }
+
+    .ct-toolbar {
+        display: flex;
+        gap: 0.6rem;
+        flex-wrap: wrap;
+        margin-bottom: 1rem;
+    }
+
+    .ct-input {
+        flex: 1;
+        min-width: 220px;
+        padding: 0.75rem 1rem;
+        border: 1px solid #ddd;
+        border-radius: 10px;
+        font-size: 0.92rem;
+    }
+
+    .ct-btn {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: 0.4rem;
+        padding: 0.7rem 1.1rem;
+        border: 1px solid transparent;
+        border-radius: 10px;
+        font-size: 0.88rem;
+        font-weight: 700;
+        text-decoration: none;
+        cursor: pointer;
+    }
+
+    .ct-btn-primary {
+        background: linear-gradient(135deg, #6b2d8f 0%, #7e3aa5 100%);
+        color: #fff;
+    }
+
+    .ct-btn-light {
+        border-color: #ddd;
+        background: #f3f3f3;
+        color: #44384c;
+    }
+
+    .ct-btn-wa {
+        background: #1fa855;
+        color: #fff;
+        white-space: nowrap;
+    }
+
+    .ct-btn-wa:hover {
+        background: #188a45;
+    }
+
+    .ct-table-wrap {
+        overflow-x: auto;
+        border-radius: 14px;
+        background: #fff;
+        box-shadow: 0 4px 14px rgba(74, 35, 95, 0.07);
+    }
+
+    .ct-table {
+        width: 100%;
+        border-collapse: collapse;
+        font-size: 0.92rem;
+    }
+
+    .ct-table th {
+        padding: 0.8rem 1rem;
+        background: #f7f2fa;
+        color: #4a235f;
+        font-size: 0.78rem;
+        text-align: left;
+        text-transform: uppercase;
+        letter-spacing: 0.03em;
+        white-space: nowrap;
+    }
+
+    .ct-table td {
+        padding: 0.8rem 1rem;
+        border-top: 1px solid #f0eaf3;
+        vertical-align: middle;
+    }
+
+    .ct-nome {
+        color: #4a235f;
+        font-weight: 800;
+    }
+
+    .ct-sub {
+        color: #7a7280;
+        font-size: 0.82rem;
+        word-break: break-word;
+    }
+
+    .ct-pill {
+        display: inline-flex;
+        padding: 0.25rem 0.7rem;
+        border-radius: 999px;
+        font-size: 0.74rem;
+        font-weight: 700;
+        letter-spacing: 0.03em;
+        text-transform: uppercase;
+        white-space: nowrap;
+    }
+
+    .ct-pill-comprou { background: #dff3e4; color: #206a38; }
+    .ct-pill-nao_finalizou { background: #fde2e5; color: #a83245; }
+    .ct-pill-em_andamento { background: #fff1d6; color: #8a5a00; }
+    .ct-pill-verificar { background: #e9e9e9; color: #555; }
+
+    .ct-aviso {
+        margin: 0 0 1rem;
+        padding: 0.8rem 1rem;
+        border-radius: 10px;
+        background: #fff8e6;
+        color: #7a5600;
+        font-size: 0.88rem;
+    }
+
+    .ct-vazio {
+        padding: 2rem;
+        text-align: center;
+        color: #7a7280;
+    }
+</style>
+
+<div class="ct-header">
+    <div>
+        <h1 style="margin: 0 0 0.25rem; color: #4a235f;">Contatos de ingressos</h1>
+        <p style="margin: 0; color: #6f6f78;">{{ espetaculo.titulo }}</p>
+    </div>
+
+    <a
+        href="{% url 'admin_dashboard:espetaculo_ingressos_vendidos' espetaculo.pk %}"
+        class="ct-btn ct-btn-light"
+    >
+        ← Voltar para ingressos vendidos
+    </a>
+</div>
+
+<div class="ct-shell">
+    <div class="ct-summary">
+        <a
+            class="ct-summary-card {% if not status_atual %}ativo{% endif %}"
+            href="?{% if busca %}q={{ busca|urlencode }}{% endif %}"
+        >
+            <div class="ct-summary-label">Todos</div>
+            <div class="ct-summary-value">{{ total_contatos }}</div>
+        </a>
+
+        <a
+            class="ct-summary-card {% if status_atual == 'nao_finalizou' %}ativo{% endif %}"
+            href="?status=nao_finalizou{% if busca %}&q={{ busca|urlencode }}{% endif %}"
+        >
+            <div class="ct-summary-label">Não finalizaram</div>
+            <div class="ct-summary-value">{{ contagem.nao_finalizou }}</div>
+        </a>
+
+        <a
+            class="ct-summary-card {% if status_atual == 'comprou' %}ativo{% endif %}"
+            href="?status=comprou{% if busca %}&q={{ busca|urlencode }}{% endif %}"
+        >
+            <div class="ct-summary-label">Compraram</div>
+            <div class="ct-summary-value">{{ contagem.comprou }}</div>
+        </a>
+
+        {% if contagem.em_andamento %}
+            <a
+                class="ct-summary-card {% if status_atual == 'em_andamento' %}ativo{% endif %}"
+                href="?status=em_andamento{% if busca %}&q={{ busca|urlencode }}{% endif %}"
+            >
+                <div class="ct-summary-label">Pagando agora</div>
+                <div class="ct-summary-value">{{ contagem.em_andamento }}</div>
+            </a>
+        {% endif %}
+
+        {% if contagem.verificar %}
+            <a
+                class="ct-summary-card {% if status_atual == 'verificar' %}ativo{% endif %}"
+                href="?status=verificar{% if busca %}&q={{ busca|urlencode }}{% endif %}"
+            >
+                <div class="ct-summary-label">Verificar no Asaas</div>
+                <div class="ct-summary-value">{{ contagem.verificar }}</div>
+            </a>
+        {% endif %}
+    </div>
+
+    {% if contagem.verificar %}
+        <p class="ct-aviso">
+            <strong>{{ contagem.verificar }}</strong> pessoa(s) aparecem como
+            "Verificar no Asaas": o Asaas indica pagamento recebido, mas o
+            pedido não está marcado como pago aqui. Confira antes de abordar.
+        </p>
+    {% endif %}
+
+    <form method="get" class="ct-toolbar">
+        {% if status_atual %}
+            <input type="hidden" name="status" value="{{ status_atual }}">
+        {% endif %}
+
+        <input
+            type="text"
+            name="q"
+            value="{{ busca }}"
+            placeholder="Buscar por nome, WhatsApp ou e-mail"
+            class="ct-input"
+        >
+
+        <button type="submit" class="ct-btn ct-btn-primary">Buscar</button>
+
+        {% if busca or status_atual %}
+            <a
+                href="{% url 'admin_dashboard:espetaculo_contatos_ingressos' espetaculo.pk %}"
+                class="ct-btn ct-btn-light"
+            >
+                Limpar filtros
+            </a>
+        {% endif %}
+    </form>
+
+    <div class="ct-table-wrap">
+        {% if contatos %}
+            <table class="ct-table">
+                <thead>
+                    <tr>
+                        <th>Pessoa</th>
+                        <th>Status</th>
+                        <th>Assentos</th>
+                        <th>Valor</th>
+                        <th>Quando</th>
+                        <th></th>
+                    </tr>
+                </thead>
+                <tbody>
+                    {% for c in contatos %}
+                        <tr>
+                            <td>
+                                <div class="ct-nome">{{ c.nome }}</div>
+                                <div class="ct-sub">{{ c.whatsapp }}</div>
+                                {% if c.email %}
+                                    <div class="ct-sub">{{ c.email }}</div>
+                                {% endif %}
+                            </td>
+
+                            <td>
+                                <span class="ct-pill ct-pill-{{ c.status }}">
+                                    {{ c.status_rotulo }}
+                                </span>
+
+                                {% if c.tentou_antes %}
+                                    <div class="ct-sub">
+                                        tentou {{ c.tentativas_sem_pagar }}x
+                                        antes de comprar
+                                    </div>
+                                {% elif c.tentativas_sem_pagar > 1 %}
+                                    <div class="ct-sub">
+                                        {{ c.tentativas_sem_pagar }} tentativas
+                                    </div>
+                                {% endif %}
+                            </td>
+
+                            <td>
+                                {% if c.assentos %}
+                                    {{ c.assentos|join:", " }}
+                                {% else %}
+                                    <span class="ct-sub">—</span>
+                                {% endif %}
+                                <div class="ct-sub">
+                                    {{ c.quantidade }} ingresso{{ c.quantidade|pluralize }}
+                                </div>
+                            </td>
+
+                            <td>R$ {{ c.valor|floatformat:2 }}</td>
+
+                            <td style="white-space: nowrap;">
+                                {{ c.quando|date:"d/m/Y H:i" }}
+                            </td>
+
+                            <td style="text-align: right;">
+                                <a
+                                    href="{{ c.whatsapp_link }}"
+                                    target="_blank"
+                                    rel="noopener noreferrer"
+                                    class="ct-btn ct-btn-wa"
+                                >
+                                    WhatsApp
+                                </a>
+                            </td>
+                        </tr>
+                    {% endfor %}
+                </tbody>
+            </table>
+        {% else %}
+            <div class="ct-vazio">
+                Nenhum contato encontrado{% if busca or status_atual %} com esses filtros{% endif %}.
+            </div>
+        {% endif %}
+    </div>
+
+    {% if sem_whatsapp %}
+        <p class="ct-sub" style="margin-top: 1rem;">
+            {{ sem_whatsapp }} pedido(s) não aparecem aqui por não terem um
+            WhatsApp válido (por exemplo, contas logadas sem telefone no perfil).
+        </p>
+    {% endif %}
+</div>
+{% endblock %}
