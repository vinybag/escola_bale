+            const dur = parseInt(campos['duracao'].value, 10);
+            const gap = parseInt(campos['intervalo'].value || '0', 10);
+            if (ini === null || fim === null || !(dur > 0) || !(fim > ini)) { previa.textContent = ''; return; }
+            let n = 0;
+            for (let t = ini; t + dur <= fim; t += dur + (gap || 0)) { n += 1; }
