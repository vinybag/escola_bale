+
+        function minutos(valor) {
+            const partes = (valor || '').split(':');
+            return partes.length === 2 ? parseInt(partes[0], 10) * 60 + parseInt(partes[1], 10) : null;
+        }
+
+        function atualizar() {
+            const campos = form.elements;
+            const ini = minutos(campos['inicio'].value);
