+
+<script>
+(function () {
+    // --- Aviso "você não está logado" (só existe no HTML quando a pessoa
+    // não está logada e o evento tem ingresso gratuito de aluna) ---
+    const overlay = document.getElementById('avisoLoginOverlay');
+
+    if (overlay) {
+        const chave = 'avisoLoginMapaVisto_' + overlay.dataset.evento;
+        let jaVisto = false;
+
+        try {
+            jaVisto = sessionStorage.getItem(chave) === '1';
+        } catch (erro) {
+            jaVisto = false;
+        }
+
+        function fecharAviso() {
+            overlay.classList.remove('is-visivel');
+
+            try {
+                sessionStorage.setItem(chave, '1');
+            } catch (erro) {
+                // sem sessionStorage (ex.: navegação privada): o aviso só
+                // vai reaparecer na próxima visita, sem problema.
+            }
+        }
+
+        if (!jaVisto) {
+            overlay.classList.add('is-visivel');
+
+            const botaoEntrar = overlay.querySelector('.btn-entrar');
+            if (botaoEntrar) {
+                botaoEntrar.focus();
+            }
+        }
+
+        document
+            .getElementById('avisoLoginContinuar')
+            .addEventListener('click', fecharAviso);
+
+        document.addEventListener('keydown', function (evento) {
+            if (evento.key === 'Escape' && overlay.classList.contains('is-visivel')) {
+                fecharAviso();
+            }
+        });
+    }
+
+    // --- Se a pessoa já escolheu assentos e clica em "Entrar", avisa
+    // antes: o login troca a sessão do navegador e os assentos já
+    // escolhidos acabam liberados. ---
+    const selo = document.getElementById('seloLogin');
+
+    if (selo) {
+        selo.addEventListener('click', function (evento) {
+            const contador = document.getElementById('totalSelecionados');
+            const total = contador ? parseInt(contador.textContent.trim(), 10) : 0;
+
+            if (
+                total > 0 &&
+                !confirm(
+                    'Ao entrar na sua conta, os assentos que você já escolheu ' +
+                    'serão liberados e você precisará escolhê-los de novo. ' +
+                    'Deseja continuar?'
+                )
+            ) {
+                evento.preventDefault();
+            }
+        });
+    }
+})();
+</script>
 {% endblock %}
