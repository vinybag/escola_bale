+    // Atualização automática: a cada alguns segundos, confere no
+    // servidor se algum assento mudou de status (ex.: uma venda feita
+    // manualmente pelo admin) e atualiza a cor na tela sozinho, sem
+    // precisar recarregar a página. Nunca mexe num assento que a
+    // própria pessoa já selecionou.
+    const urlStatusAssentos =
+        "{% url 'espetaculo:assentos_status_api' espetaculo.pk %}";
+
+    function atualizarStatusAssentosRemoto() {
+        fetch(urlStatusAssentos)
+            .then(function (resposta) {
+                return resposta.json();
+            })
+            .then(function (dados) {
+                const statusPorId =
+                    dados.assentos || {};
+
+                document
+                    .querySelectorAll(
+                        '.mapa-publico-assento'
+                    )
+                    .forEach(function (botao) {
+                        if (
+                            botao.classList.contains(
+                                'selecionado'
+                            )
+                        ) {
+                            return;
+                        }
+
+                        const statusNovo =
+                            statusPorId[
+                                botao.dataset.id
+                            ];
+
+                        if (
+                            !statusNovo ||
+                            statusNovo ===
+                                botao.dataset.status
+                        ) {
+                            return;
+                        }
+
+                        botao.dataset.status =
+                            statusNovo;
+
+                        botao.dataset.clicavel =
+                            statusNovo === 'disponivel'
+                                ? '1'
+                                : '0';
+
+                        const svg =
+                            botao.querySelector('svg');
+
+                        if (svg) {
+                            svg.classList.remove(
+                                'status-disponivel',
+                                'status-ocupado'
+                            );
+
+                            svg.classList.add(
+                                statusNovo ===
+                                    'disponivel'
+                                    ? 'status-disponivel'
+                                    : 'status-ocupado'
+                            );
+                        }
+                    });
+            })
+            .catch(function () {
+                // Falha silenciosa: se a atualização automática não
+                // funcionar por um instante (ex.: sem internet), o
+                // mapa continua utilizável normalmente — o clique em
+                // qualquer assento sempre confere o status real no
+                // servidor antes de reservar.
+            });
+    }
+
+    setInterval(
+        atualizarStatusAssentosRemoto,
+        8000
+    );
+
