+def assentos_status_api(request, pk):
+    """
+    Retorna, em JSON, o status atual (resumido) de cada assento do mapa
+    deste evento: 'disponivel' ou 'ocupado' (cobre vendido, reservado
+    por qualquer sessão, ou bloqueado manualmente).
+
+    Usado pelo mapa público para se atualizar sozinho por polling
+    (a cada alguns segundos), sem precisar de um F5: por exemplo, se uma
+    venda é feita manualmente pelo admin enquanto alguém está olhando o
+    mapa, o assento correspondente passa a aparecer em vermelho para
+    essa pessoa também, sem ela precisar recarregar a página.
+
+    Não expõe nenhum dado sensível — só o id do assento e um status
+    resumido — por isso não exige login nem CSRF.
+    """
+    evento = get_object_or_404(
+        Espetaculo,
+        pk=pk,
+        ativo=True,
+    )
+
+    mapa = getattr(evento, 'mapa_assentos', None)
+
+    if mapa:
+        liberar_assentos_expirados(mapa)
+
+        dados = {
+            str(assento_id): (
+                'disponivel'
+                if status == 'disponivel'
+                else 'ocupado'
+            )
+            for assento_id, status in mapa.assentos.values_list(
+                'id',
+                'status',
+            )
+        }
+    else:
+        dados = {}
+
+    resposta = JsonResponse({'assentos': dados})
+
+    # Evita que qualquer camada de cache (CDN, proxy, navegador) sirva
+    # uma versão antiga desta resposta — ela precisa refletir o status
+    # real do banco a cada chamada.
+    resposta['Cache-Control'] = 'no-store'
+
+    return resposta
+
+
 @require_POST
